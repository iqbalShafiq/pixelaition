# The agentic model provider. The main drawing agent uses OpenCode Go:
# https://opencode.ai/inference/go/v1. The catalog is deepseek-v4.1-flash
# (chat) and muse-spark-1.3-contributor (responses, vision).
# The worker sends x-opencode-session, x-opencode-client and a pixelaition
# user-agent on OpenCode requests. A fresh API key comes from
# https://opencode.ai/console (the free/expired key cannot be reused).
AGENT_BASE_URL=https://opencode.ai/inference/go/v1
AGENT_API_KEY=

# The decision model (Jev) stays on OpenRouter. The provider's API root; the
# Decisions path (/alpha/decisions) is appended.
DECISION_MODEL_BASE_URL=https://openrouter.ai/api
DECISION_MODEL_API_KEY=
DECISION_MODEL=

# Web search for reference images and facts (Tavily). Empty keeps web_search
# and view_image out of the agent's toolset; get a key at https://tavily.com
TAVILY_API_KEY=

# Required by pnpm eval:judge. A model from the models table that supports
# structured outputs, served by the agent provider.
EVAL_MODEL=deepseek-v4.1-flash

# Host development. Compose overrides this for containers so they reach the db service.
DATABASE_URL=postgresql://pixelaition:pixelaition@localhost:5432/pixelaition

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000

WORKER_INTERNAL_URL=http://localhost:4002
WORKER_INTERNAL_TOKEN=replace-with-a-long-random-token
DURABLE_DATABASE_PATH=./data/anvia-runs.sqlite

# Leave blank to run without tracing. With the observability profile, use http://localhost:3100
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

API_PORT=3001
WORKER_PORT=4002
WEB_ORIGIN=http://localhost:3000
