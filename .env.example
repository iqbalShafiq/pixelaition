# OpenAI-compatible chat. Point this at OpenRouter or any compatible endpoint,
# for example the OpenCode Go endpoint at https://opencode.ai/zen/go/v1.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini

# Optional. The composer's model choices as JSON: id, api family (chat or
# responses), and the reasoning-effort options each model offers. Order is
# kept. When empty, the provider's /models list is shown with generic efforts.
# OPENAI_MODELS=[{"id":"deepseek-v4.1-flash","api":"chat","efforts":["low","high","max"]},{"id":"muse-spark-1.3-contributor","api":"responses","efforts":["minimal","low","medium","high","xhigh"]}]
EVAL_MODEL=

# Optional. When set, semantic decisions use Jev.
TYPESAFE_API_KEY=

# Optional. Used for semantic decisions only when TYPESAFE_API_KEY is empty.
# The decision model must support structured outputs. Leave blank to use the
# offline decision.
DECISION_MODEL=

# Host development. Compose overrides this for containers so they reach the db service.
DATABASE_URL=postgresql://pixelaition:pixelaition@localhost:5432/pixelaition

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000

WORKER_INTERNAL_URL=http://localhost:4002
WORKER_INTERNAL_TOKEN=replace-with-a-long-random-token
DURABLE_DATABASE_PATH=./data/anvia-runs.sqlite

# Leave blank to run without tracing. With the observability profile, use http://localhost:3100
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

API_PORT=3001
WORKER_PORT=4002
WEB_ORIGIN=http://localhost:3000
