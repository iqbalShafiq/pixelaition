# The agentic model provider (OpenAI-compatible). Models come from the `models`
# table, seeded by migrations; the catalog is deepseek/deepseek-v4.1-flash-1017
# (chat, summary text) and meta/muse-spark-1.3-contributor (responses, vision).
# OpenRouter's OpenAI-compatible root is https://openrouter.ai/api/v1.
AGENT_BASE_URL=
AGENT_API_KEY=

# The decision model (Jev). The provider's API root; the Decisions path
# (/alpha/decisions) is appended. OpenRouter: https://openrouter.ai/api
DECISION_MODEL_BASE_URL=
DECISION_MODEL_API_KEY=
DECISION_MODEL=

# Web search for reference images and facts (Tavily). Empty keeps web_search
# and view_image out of the agent's toolset; get a key at https://tavily.com
TAVILY_API_KEY=

# Required by pnpm eval:judge. A model from the models table that supports
# structured outputs, served by the agent provider.
EVAL_MODEL=deepseek/deepseek-v4.1-flash-1017

# Host development. Compose overrides this for containers so they reach the db service.
DATABASE_URL=postgresql://pixelaition:pixelaition@localhost:5432/pixelaition

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000

WORKER_INTERNAL_URL=http://localhost:4002
WORKER_INTERNAL_TOKEN=replace-with-a-long-random-token
DURABLE_DATABASE_PATH=./data/anvia-runs.sqlite

# Leave blank to run without tracing. With the observability profile, use http://localhost:3100
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

API_PORT=3001
WORKER_PORT=4002
WEB_ORIGIN=http://localhost:3000
