{
  "name": "pixelaition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@anvia/openai": "patches/@anvia__openai@1.3.0.patch"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --filter=@pixelaition/api --filter=@pixelaition/worker --filter=@pixelaition/web",
    "dev:infra": "docker compose up -d db",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "eval": "dotenv -e .env -- pnpm --filter @pixelaition/agent eval",
    "eval:judge": "dotenv -e .env -- pnpm --filter @pixelaition/agent eval:judge",
    "db:migrate": "dotenv -e .env -- pnpm --filter @pixelaition/db migrate",
    "docker:up": "docker compose up --build",
    "prepare": "husky",
    "eval:jev": "dotenv -e .env -- pnpm --filter @pixelaition/agent eval:jev",
    "eval:jev:decisions": "dotenv -e .env -- pnpm --filter @pixelaition/agent eval:jev:decisions",
    "eval:social": "dotenv -e .env -- pnpm --filter @pixelaition/agent eval:social",
    "postinstall": "node tools/patch-anvia-openai.mjs",
    "test:integration": "dotenv -e .env -- pnpm --filter @pixelaition/api test && dotenv -e .env -- pnpm --filter @pixelaition/worker test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "cli": "pnpm --filter @pixelaition/cli start"
  },
  "lint-staged": {
    "*.{ts,tsx,js,css,md,json,yml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.64.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  }
}
