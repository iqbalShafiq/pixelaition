{
  "name": "pixelaition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --filter=@pixelaition/api --filter=@pixelaition/worker --filter=@pixelaition/web",
    "dev:infra": "docker compose up -d db",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "eval": "dotenv -e .env -- pnpm --filter @pixelaition/agent eval",
    "eval:judge": "dotenv -e .env -- pnpm --filter @pixelaition/agent eval:judge",
    "db:migrate": "dotenv -e .env -- pnpm --filter @pixelaition/db migrate",
    "docker:up": "docker compose up --build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,css,md,json,yml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  }
}
