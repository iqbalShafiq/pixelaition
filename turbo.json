{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {},
    "lint": {},
    "test": {},
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "WEB_ORIGIN",
        "OPENAI_*",
        "EVAL_MODEL",
        "TYPESAFE_API_KEY",
        "WORKER_*",
        "DURABLE_DATABASE_PATH",
        "LANGFUSE_*",
        "API_PORT",
        "NODE_ENV"
      ]
    }
  }
}
